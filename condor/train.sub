# HTCondor submit file for GPU training at CERN. Submit from lxplus, in this directory,
# with a valid Kerberos ticket (EOS access from the job uses it):
#
#   ./make_bundle.sh                     # packs the committed code into fcctrackfit_code.tar.gz
#   condor_submit train.sub              # defaults below
#   condor_submit train.sub OVERRIDES="train.epochs=8"       # cld_mu_v2, phase 1, 8 epochs
#   condor_submit train.sub CONFIG=fcctrackfit/config/train/phase2.yaml RUN=cld_mu_v2_phase2 \
#       INIT_FROM=/eos/user/d/dlange/fcctracking/runs/cld_mu_v2_phase1/final.pt
# (phase 2 needs INIT_FROM: its config's init_from is a local path)
#
# Extra training overrides: OVERRIDES="train.epochs=10 train.lr=1e-4"
# Newest GPUs only: condor_submit train.sub "GPUS=H100 NVL|H200"

# Defaults. condor_submit applies KEY=value arguments before reading this file, so each
# default is set only if the macro is not already defined (otherwise it would win).
if !defined CONFIG
  CONFIG = fcctrackfit/config/train/phase1.yaml
endif
if !defined DATA
  DATA = /eos/user/d/dlange/fcctracking/cld_mu_v2
endif
if !defined RUN
  RUN = cld_mu_v2_phase1
endif
if !defined RUNS_DIR
  RUNS_DIR = /eos/user/d/dlange/fcctracking/runs
endif
if !defined NGPU
  NGPU = 1
endif
if !defined CPUS
  CPUS = 4
endif
if !defined MEMORY
  MEMORY = 12 GB
endif
if !defined DISK
  DISK = 15 GB
endif
if !defined INIT_FROM
  INIT_FROM = 
endif
if !defined OVERRIDES
  OVERRIDES = 
endif
if !defined GPUS
  GPUS = A100|H100|H200|T4
endif

executable            = train_job.sh
arguments             = $(CONFIG) $(DATA) $(RUNS_DIR)/$(RUN) $(OVERRIDES)
environment           = "EOS_MGM=root://eosuser.cern.ch INIT_FROM=$(INIT_FROM) SYNC_SECONDS=900"
transfer_input_files  = fcctrackfit_code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

output = logs/$(RUN).$(ClusterId).out
error  = logs/$(RUN).$(ClusterId).err
log    = logs/$(RUN).$(ClusterId).log
# stdout/stderr come back only at the end (CERN no longer allows streaming). While the job
# runs: condor_tail <ClusterId>, or train.out in $(RUNS_DIR)/$(RUN) (synced every SYNC_SECONDS)

request_gpus   = $(NGPU)
# 4 CPUs / 12 GB fit every usable GPU slot, including the H100 MIG slices (1g.12gb: 6 CPUs,
# 17 GB); asking for more limits the job to the (often busy) A100 / H100 NVL nodes.
# Data-loader workers = CPUs - 1 per GPU (train_job.sh).
request_cpus   = $(CPUS)
request_memory = $(MEMORY)
# the staged train + val shards (~8.6 GB for cld_mu_v2) go to the slot's scratch disk
request_disk   = $(DISK)
# "testmatch" = 3 days, "nextweek" = 1 week. The job resumes from $(RUNS_DIR)/$(RUN)/last.pt
# if it is resubmitted after hitting the limit.
+JobFlavour = "testmatch"
# GPU type (list with: condor_status -constraint 'TotalGpus > 0' -af GPUs_DeviceName | sort | uniq -c ).
# Open to general users (Oct 2026): A100-40GB, H100 NVL, V100(S)-32GB, T4, H100 MIG slices (12/24 GB).
# The H200s and some H100 NVLs are reserved for the BE-ABP / ATS GPU groups and never match.
# V100s cannot be used: the LCG torch builds (108-110a) have kernels for sm_75 and newer only.
# Default GPUS: A100, H100 (NVL and MIG slices), H200, T4. Pin a type with e.g. "GPUS=H100 NVL" or
# GPUS=A100; MIG slices hold one job's single GPU, so use "GPUS=A100|H100 NVL" with NGPU > 1.
requirements = regexp("$(GPUS)", TARGET.GPUs_DeviceName)

queue
