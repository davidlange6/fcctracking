# HTCondor submit file for GPU training at CERN. Submit from lxplus, in this directory,
# with a valid Kerberos ticket (EOS access from the job uses it):
#
#   ./make_bundle.sh                     # packs the committed code into fcctrackfit_code.tar.gz
#   condor_submit train.sub              # defaults below
#   condor_submit train.sub CONFIG=fcctrackfit/config/train/phase2.yaml RUN=cld_mu_v1_phase2 \
#       NGPU=2 CPUS=16 "MEMORY=32 GB" INIT_FROM=/eos/user/d/dlange/fcctracking/runs/cld_mu_v1_phase1/final.pt
# (phase 2 needs INIT_FROM: its config's init_from is a local path)
#
# Extra training overrides: OVERRIDES="train.epochs=10 train.lr=1e-4"
# Newest GPUs only: condor_submit train.sub "GPUS=H100 NVL|H200"

CONFIG    = fcctrackfit/config/train/phase1.yaml
DATA      = /eos/user/d/dlange/fcctracking/cld_mu_v1
RUN       = cld_mu_v1_phase1
RUNS_DIR  = /eos/user/d/dlange/fcctracking/runs
NGPU      = 1
CPUS      = 8
MEMORY    = 16 GB
INIT_FROM =
OVERRIDES =

executable            = train_job.sh
arguments             = $(CONFIG) $(DATA) $(RUNS_DIR)/$(RUN) $(OVERRIDES)
environment           = "EOS_MGM=root://eosuser.cern.ch INIT_FROM=$(INIT_FROM) SYNC_SECONDS=900"
transfer_input_files  = fcctrackfit_code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

output = logs/$(RUN).$(ClusterId).out
error  = logs/$(RUN).$(ClusterId).err
log    = logs/$(RUN).$(ClusterId).log

request_gpus   = $(NGPU)
# scale with NGPU: 8 data-loader workers and ~16 GB per GPU
request_cpus   = $(CPUS)
request_memory = $(MEMORY)
# "testmatch" = 3 days, "nextweek" = 1 week. The job resumes from $(RUNS_DIR)/$(RUN)/last.pt
# if it is resubmitted after hitting the limit.
+JobFlavour = "testmatch"
# GPU type (list with: condor_status -constraint 'TotalGpus > 0' -af GPUs_DeviceName | sort | uniq -c ).
# The CERN pool (Oct 2026) has A100-40GB, H100 NVL, H200, V100(S)-32GB, T4 and H100 MIG slices (12/24 GB).
# Default GPUS: everything except MIG slices and T4s. Pin a type with e.g. GPUS=H100|H200 or GPUS=A100.
GPUS         = A100|H100 NVL|H200|V100
requirements = regexp("$(GPUS)", TARGET.GPUs_DeviceName)

queue
